rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public upload is restricted by size and image MIME type. Files are not publicly readable.
    match /service-photos/{fileName} {
      allow write: if request.resource != null && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if false;
    }
  }
}